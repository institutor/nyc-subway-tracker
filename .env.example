PORT=3000
TRANSIT_RUNTIME_MODE=validation
TRANSIT_DATA_DIRECTORY=.data

# Optional official equipment endpoints. Leave unset when unavailable.
MTA_EQUIPMENT_URL=
MTA_OUTAGE_URL=
MTA_API_KEY=

# Optional audited walking provider. Configuration alone does not approve it.
PRACTICAL_WALK_URL=

# Shadow artifacts stay local and ignored by git.
SHADOW_OUTPUT_DIRECTORY=.data/shadow
